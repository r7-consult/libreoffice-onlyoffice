# Build image for the Linux build of pluginhost. NOT BUILT YET: written without Docker or Linux at hand.
#
# Base: Ubuntu 22.04 (jammy), the oldest baseline we want to support (glibc 2.35, libstdc++ from GCC 12).
# A library built here also loads on newer glibc/libstdc++, not the other way round.
#
# WARNING: jammy ships LibreOffice 7.3.x, but extension/description.xml asks for LibreOffice >= 7.6. The library
# compiles against the 7.3 SDK, but unopkg on a 7.3 office will refuse the package. To build against a newer office
# use another base image:   docker build --build-arg BASE_IMAGE=ubuntu:24.04 -f docker/Dockerfile.linux -t pluginhost-build .
#
# Use:
#   docker build -f docker/Dockerfile.linux -t pluginhost-build .
#   docker run --rm -it -v "$PWD":/work pluginhost-build            (opens a shell in /work)
#   docker run --rm -v "$PWD":/work pluginhost-build -c 'bash scripts/fetch_quickjs.sh && bash scripts/gen_uno_headers.sh && bash scripts/build.sh'
# Files written into /work are owned by root; add  --user "$(id -u):$(id -g)"  to avoid that (then HOME is not writable,
# which these scripts do not need).
ARG BASE_IMAGE=ubuntu:22.04
FROM ${BASE_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive

# Package notes (from memory of the jammy package lists, not checked against a live apt):
#   libreoffice-dev, libreoffice-dev-common  universe. SDK in /usr/lib/libreoffice/sdk.
#   libreoffice-core, libreoffice-common     my addition: program folder with types.rdb, types/offapi.rdb, unopkg.
#                                            Needed because --no-install-recommends is used.
#   libwebkit2gtk-4.1-dev                    expected in jammy (webkit2gtk 2.4x via jammy-updates). If apt cannot find it,
#                                            the fallback is libwebkit2gtk-4.0-dev, but then src/CMakeLists.txt must ask
#                                            pkg-config for webkit2gtk-4.0 (libsoup2 flavour) instead of webkit2gtk-4.1.
#   nodejs                                   jammy has Node 12.22. The tests use plain CommonJS, but Node 12 is untested;
#                                            build with --build-arg NODE_MAJOR=20 to take Node from NodeSource instead.
#   unzip, git, ca-certificates              my additions (checking the .oxt, fetching sources over https).
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
        build-essential cmake ninja-build pkg-config \
        libreoffice-dev libreoffice-dev-common libreoffice-core libreoffice-common \
        libgtk-3-dev libwebkit2gtk-4.1-dev libx11-dev \
        python3 nodejs zip unzip curl ca-certificates git \
 && rm -rf /var/lib/apt/lists/*

# Optional newer Node. Uses the NodeSource setup script (downloaded over https, run as root in the image build).
ARG NODE_MAJOR=
RUN if [ -n "${NODE_MAJOR}" ]; then \
      curl -fsSL "https://deb.nodesource.com/setup_${NODE_MAJOR}.x" -o /tmp/nodesource_setup.sh \
      && bash /tmp/nodesource_setup.sh \
      && apt-get install -y --no-install-recommends nodejs \
      && rm -rf /var/lib/apt/lists/* /tmp/nodesource_setup.sh; \
    fi

# Same defaults as the scripts; written out so that `env` in the container shows them.
ENV LO_SDK=/usr/lib/libreoffice/sdk \
    LO_PROGRAM=/usr/lib/libreoffice/program

WORKDIR /work
ENTRYPOINT ["/bin/bash"]
