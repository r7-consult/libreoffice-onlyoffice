<?xml version="1.0" encoding="UTF-8"?>
<!-- Registers one deck with one panel. Modelled on officecfg/.../UI/Sidebar.xcu.
     Only the deck and panel nodes are added; the sidebar itself is not replaced. -->
<oor:component-data oor:name="Sidebar" oor:package="org.openoffice.Office.UI" xmlns:oor="http://openoffice.org/2001/registry" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <node oor:name="Content">
    <node oor:name="DeckList">
      <node oor:name="PluginHostDeck" oor:op="replace">
        <prop oor:name="Title" oor:type="xs:string">
          <value xml:lang="en-US">Plugin Host</value>
        </prop>
        <prop oor:name="Id" oor:type="xs:string">
          <value>PluginHostDeck</value>
        </prop>
        <!-- Built-in icon until the extension ships its own; without IconURL the tab is blank. -->
        <prop oor:name="IconURL" oor:type="xs:string">
          <value>private:graphicrepository/cmd/lc_adddirect.png</value>
        </prop>
        <prop oor:name="ContextList">
          <value oor:separator=";">
            any, any, visible ;
          </value>
        </prop>
        <prop oor:name="OrderIndex" oor:type="xs:int">
          <value>1000</value>
        </prop>
      </node>
    </node>
    <node oor:name="PanelList">
      <node oor:name="PluginHostPanel" oor:op="replace">
        <prop oor:name="Title" oor:type="xs:string">
          <value xml:lang="en-US">Plugins</value>
        </prop>
        <prop oor:name="Id" oor:type="xs:string">
          <value>PluginHostPanel</value>
        </prop>
        <prop oor:name="DeckId" oor:type="xs:string">
          <value>PluginHostDeck</value>
        </prop>
        <prop oor:name="ContextList">
          <value oor:separator=";">
            WriterVariants, default, visible ;
            Calc, default, visible ;
          </value>
        </prop>
        <prop oor:name="ImplementationURL" oor:type="xs:string">
          <value>private:resource/toolpanel/org.example.pluginhost/PluginHostPanel</value>
        </prop>
        <prop oor:name="OrderIndex" oor:type="xs:int">
          <value>100</value>
        </prop>
      </node>
    </node>
  </node>
</oor:component-data>
